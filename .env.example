# Railway OAuth app credentials
# Create one at https://railway.com/workspace/<workspace>/settings/developer
RAILWAY_CLIENT_ID=
RAILWAY_CLIENT_SECRET=

# Optional: 32+ char random string used to encrypt the session cookie.
# If unset, derived from RAILWAY_CLIENT_SECRET.
# RAILWAY_SESSION_SECRET=

# Optional: GitHub PAT for the /api/search/github route to avoid IP rate limits.
# GITHUB_TOKEN=
